# Copy to `.env` next to deploy/docker-compose.yml and adjust to match your
# VPS / Traefik setup. On the VPS the deploy script (deploy/deploy.sh)
# generates this file per environment, including the secrets.

# --- Environment selection (set per deploy) -------------------------------
# production : api.gewerber.de      gwb       gewerber-backend       production
# staging    : api.test.gewerber.de gwb-test  gewerber-backend-test  staging

# Container name (must be unique per environment).
CONTAINER_NAME=gewerber-backend

# Traefik router/middleware/service name prefix (unique per environment).
ROUTER_PREFIX=gwb

# Image to run (CI pushes to GHCR; locally the image is built from source).
IMAGE=ghcr.io/gewerber/gewerber-backend:prod-latest

# Serverpod run mode: production | staging.
RUNMODE=production

# Traefik Host rule (backticks are literal Traefik syntax).
HOST_RULE=Host(`api.gewerber.de`)

# --- Secrets (deploy.sh generates these once per environment) -------------
# PostgreSQL password (POSTGRES_PASSWORD) and Serverpod `database` password.
DB_PASSWORD=change-me

# Redis password (`--requirepass`) and Serverpod `redis` password.
REDIS_PASSWORD=change-me

# --- Traefik integration ---------------------------------------------------
# Name of the external Docker network your Traefik container is attached to.
TRAEFIK_NETWORK=web

# Traefik entrypoints (must exist in your Traefik static config).
WEB_ENTRYPOINT=web
WEBSECURE_ENTRYPOINT=websecure

# TLS certificate resolver configured in Traefik (e.g. Let's Encrypt).
CERT_RESOLVER=letsencrypt

# --- Transactional email (SMTP) ----------------------------------------------
# Used for verification codes (registration, password reset). If SMTP_HOST is
# left empty, the server only logs the codes instead of sending them.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=465
#SMTP_USERNAME=user@example.com
#SMTP_PASSWORD=change-me
#SMTP_FROM_ADDRESS=noreply@example.com
#SMTP_FROM_NAME=Gewerber
#SMTP_SSL=true

# --- Optional social sign-in credentials (written by deploy/deploy.sh) -------
# When deploying via deploy/deploy.sh, non-empty variables below are written to
# config/passwords.yaml. A provider whose driving variable and required keys
# are omitted or blank is disabled at startup; the server still starts.
# Google: single-line JSON from `jq -c . google_client_secret.json`.
#GOOGLE_CLIENT_SECRET_JSON=
# Apple: multi-line `.p8` PEM preserves newlines via `APPLE_KEY="$(cat AuthKey_XXXXXX.p8)"`.
#APPLE_SERVICE_IDENTIFIER=de.gewerber.app.service
#APPLE_BUNDLE_IDENTIFIER=de.gewerber.app
#APPLE_REDIRECT_URI=https://api.gewerber.de/auth/apple/callback
#APPLE_TEAM_ID=
#APPLE_KEY_ID=
#APPLE_KEY=
#APPLE_ANDROID_PACKAGE_IDENTIFIER=
#APPLE_WEB_REDIRECT_URI=
# Facebook:
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=
# Microsoft (written when MICROSOFT_CLIENT_ID is set; tenant is optional):
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT=common

# --- Resource limits (docker compose `deploy.resources.limits`) --------------
# Defaults suit a small VPS (2 vCPU / 4 GB); uncomment and adjust per env.
#SERVER_MEM_LIMIT=1g
#SERVER_MEM_RESERVATION=256m
#SERVER_CPU_LIMIT=1.0
#POSTGRES_MEM_LIMIT=512m
#POSTGRES_MEM_RESERVATION=256m
#POSTGRES_CPU_LIMIT=0.50
#REDIS_MEM_LIMIT=256m
#REDIS_MEM_RESERVATION=64m
#REDIS_CPU_LIMIT=0.25
