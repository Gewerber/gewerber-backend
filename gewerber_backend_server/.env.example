# Copy to `.env` (next to this file) and fill in the PostgreSQL passwords
# used by docker-compose.yaml. Compose loads `.env` from this directory
# automatically; the file is gitignored, the passwords are local only.

# --- Development PostgreSQL (postgres, port 8090) ---------------------------
# Must match the `development:` block `database:` value in the gitignored
# config/passwords.yaml.
POSTGRES_PASSWORD=

# --- Test PostgreSQL (postgres_test, port 9090) ------------------------------
# Must match the `test:` block `database:` value in the gitignored
# config/passwords.yaml.
POSTGRES_TEST_PASSWORD=
